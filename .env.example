# Public domain pointing at your VM (free via DuckDNS, e.g. dp-ipo.duckdns.org)
DOMAIN=your-name.duckdns.org

# Generate with: openssl rand -base64 32
KYC_ENCRYPTION_KEY=PASTE_GENERATED_KEY_HERE

# Generate with: openssl rand -base64 32  (min 32 chars; changing it logs everyone out)
AUTH_JWT_SECRET=PASTE_GENERATED_SECRET_HERE
